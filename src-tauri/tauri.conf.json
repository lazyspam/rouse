{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rouse",
  "version": "0.1.1",
  "identifier": "com.iput-object.rouse",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rouse",
        "width": 1200,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Start your dev projects from one window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/iput-object/rouse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMTNDRUZBMzBBMUE4NDIKUldSQ3FLRXcrczRUL2dFbDNIS25QbzhpK2tBTzFkd2FKV2VObENCeER1eFBRUXhEZ1N5TzFKQ2UK"
    }
  }
}
